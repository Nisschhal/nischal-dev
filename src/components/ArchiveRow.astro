---
import type { Project } from '../lib/projects';

interface Props {
  project: Project;
}

const { project: p } = Astro.props;

// Archive rows are terse by design — the first three stack tags carry the
// signal, the rest would just wrap and push the links off the line.
const tags = p.stack.slice(0, 3).join(' · ');
const more = p.stack.length > 3 ? ` +${p.stack.length - 3}` : '';
---

{/* Every cell is placed explicitly. Grid resolves definite-position items
    before auto-placed ones, so leaving the title auto let the tags span claim
    column 1 and pushed the name to the middle of the row. */}
<li
  data-stack={p.stack.join('|')}
  {/* Title column widens at lg so the longest names ("Wellness Nepal Gym
      Equipments" + its CLIENT WORK label) fit without truncating, while narrow
      screens keep a balanced split against the stack column. */}
  class="group grid grid-cols-[1fr_auto] gap-x-4 gap-y-1 items-baseline border-b border-border py-3 last:border-b-0 sm:grid-cols-[minmax(0,20rem)_1fr_auto] lg:grid-cols-[minmax(0,25rem)_1fr_auto]"
>
  {/* The note sits OUTSIDE the truncating element. Inside it, "client work" was
      being clipped to "CLIENT …" on any title long enough to fill the column —
      which defeats the point of labelling it. */}
  <span
    class="col-start-1 row-start-1 flex items-baseline gap-2 min-w-0 sm:col-start-1"
  >
    <span class="font-bold text-sm text-text truncate">
      <span aria-hidden="true" class="text-dim font-normal text-xs mr-1.5">—</span>
      {p.title}
    </span>
    {
      p.note && (
        <span class="shrink-0 text-[10px] uppercase tracking-wider text-dim">
          {p.note}
        </span>
      )
    }
    {
      /* Only non-live states are badged. A "LIVE" chip on every row would be
         noise; "WIP" and "ARCHIVED" are the ones a reader needs, so a link to a
         pre-launch build isn't mistaken for a shipped product. */
      p.status !== 'live' && (
        <span
          class:list={[
            'shrink-0 border px-1 py-px text-[10px] uppercase tracking-wider',
            p.status === 'wip'
              ? 'text-warn border-warn/40'
              : 'text-dim border-border',
          ]}
        >
          {p.status}
        </span>
      )
    }
  </span>

  <span
    class="col-start-1 col-span-2 row-start-2 text-xs text-dim truncate sm:col-start-2 sm:col-span-1 sm:row-start-1"
  >
    {tags}{more}
  </span>

  <span
    class="col-start-2 row-start-1 flex items-center gap-3 text-xs shrink-0 sm:col-start-3"
  >
    <span class="text-dim tabular-nums">{p.year}</span>
    {
      p.liveUrl && (
        <a
          href={p.liveUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="no-underline text-dim hover:text-accent transition-colors"
        >
          live ↗
        </a>
      )
    }
    {
      /* No repo field → no source link. This is the client-work path: an entry
         with no `repo:` renders live-only. See decisions/0010. */
      p.repoUrl && (
        <a
          href={p.repoUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="no-underline text-dim hover:text-accent transition-colors"
        >
          code ↗
        </a>
      )
    }
  </span>
</li>
