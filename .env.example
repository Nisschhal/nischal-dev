# Copy to .env and fill in.  cp .env.example .env
# .env is gitignored — never commit real tokens.

# ─── Ngrok (required for the tunnel) ─────────────────────────────────────────
# Get yours: https://dashboard.ngrok.com/get-started/your-authtoken
# `docker compose up` fails fast with a readable message if this is unset.
NGROK_AUTHTOKEN=

# Reserved domain, paid plans only. With one set, add `--url=${NGROK_DOMAIN}` to
# the ngrok command in docker-compose.yml for a stable URL and no interstitial.
# NGROK_DOMAIN=your-name.ngrok.app

# ─── Local ports ─────────────────────────────────────────────────────────────
# Host port for the site. Changing it does NOT affect the tunnel, which targets
# web:80 on the internal compose network.
WEB_PORT=8080

# ─── GitHub sync (optional) ──────────────────────────────────────────────────
# Only used by `pnpm sync`, never during a build. Unauthenticated works fine at
# 60 req/hr; a token raises it to 5000/hr. Needs no scopes — public read only.
# GITHUB_TOKEN=

# ─── Site origin (optional) ──────────────────────────────────────────────────
# Absolute URLs for sitemap/canonical/OG tags. Set once you have a stable domain.
# PUBLIC_SITE_URL=https://nischal.dev

# ─── PHASE 2 — not used yet ──────────────────────────────────────────────────
# POSTGRES_PASSWORD=
# SESSION_SECRET=
